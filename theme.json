{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "name": "Negro",    "slug": "negro",    "color": "#131313" },
        { "name": "Primario", "slug": "primario", "color": "#ff8d6a" },
        { "name": "Gris",     "slug": "gris",     "color": "#edebea" },
        { "name": "Blanco",   "slug": "blanco",   "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "Akzidenz-Grotesk BQ",
          "slug": "akzidenz",
          "fontFamily": "\"Akzidenz-Grotesk BQ\", sans-serif"
        },
        {
          "name": "SaaSeriesEDOT",
          "slug": "saaseries",
