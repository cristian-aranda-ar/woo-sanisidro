        { "name": "X-Grande", "slug": "x-large",  "size": "1.75rem"  },
        { "name": "2X-Grande","slug": "xx-large", "size": "2.5rem"   },
        { "name": "3X-Grande","slug": "xxx-large","size": "3.5rem"   }
